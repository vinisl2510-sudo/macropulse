{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://macropulse-api.onrender.com/api/:path*" },
    { "source": "/swagger-ui/:path*", "destination": "https://macropulse-api.onrender.com/swagger-ui/:path*" },
    { "source": "/swagger-ui.html", "destination": "https://macropulse-api.onrender.com/swagger-ui.html" },
    { "source": "/v3/api-docs/:path*", "destination": "https://macropulse-api.onrender.com/v3/api-docs/:path*" },
    { "source": "/v3/api-docs", "destination": "https://macropulse-api.onrender.com/v3/api-docs" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
