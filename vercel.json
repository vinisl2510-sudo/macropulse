{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "front": {
      "root": "front",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "back/macropulse",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/swagger-ui.html", "destination": { "service": "api" } },
    { "source": "/swagger-ui/(.*)", "destination": { "service": "api" } },
    { "source": "/v3/api-docs", "destination": { "service": "api" } },
    { "source": "/v3/api-docs/(.*)", "destination": { "service": "api" } },
    { "source": "/actuator/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "front" } }
  ]
}
